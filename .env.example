# ── Google / ADK ─────────────────────────────────────────────────────────────
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=

# ── Firestore ────────────────────────────────────────────────────────────────
FIRESTORE_DATABASE=agent-demo-db

# ── BigQuery ─────────────────────────────────────────────────────────────────
# Must match where the data lives. bigquery-public-data is in the US multi-region.
BQ_LOCATION=US
# Cost guard for run_sql_query. LIMIT does not reduce bytes scanned, so an
# unbounded SELECT * on a large table is billed in full. Default 20 GiB.
BQ_MAX_BYTES_BILLED=21474836480
# Server-side job timeout, in seconds. BigQuery cancels the job itself.
BQ_QUERY_TIMEOUT_SECONDS=120

# Datasets the schema indexer walks. Empty = every dataset in the project.
# Entries may be cross-project ("project.dataset"); queries are still billed to
# GOOGLE_CLOUD_PROJECT. A bare id resolves against GOOGLE_CLOUD_PROJECT.
BQ_DATASETS=bigquery-public-data.epa_historical_air_quality

# ── Schema index (RAG) ───────────────────────────────────────────────────────
SCHEMA_INDEX_COLLECTION=schema_index
